# --- Environment Variables ---
# Copy this file to .env and fill in real values from your secrets manager.
# NEVER commit .env or real secret values to Git.
# See docs/security/SECRETS_ROTATION.md for rotation instructions.

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL)
# Local (docker compose):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ithracode"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ithracode"
# Neon (cloud):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ithracode"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ithracode"

# Redis (BullMQ / Caching)
# Local (docker compose): redis://localhost:6380
REDIS_URL="redis://localhost:6380"

# Auth (Auth.js v5)
# Generate with: openssl rand -hex 32
AUTH_SECRET="REPLACE_WITH_64_HEX_CHARS"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# AUTH_URL is the site origin (not /api/auth). Required in production too.

# OAuth Providers
# Google: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="REPLACE_WITH_GOOGLE_CLIENT_ID"
AUTH_GOOGLE_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"
# GitHub: https://github.com/settings/developers
# Callback URL: https://YOUR_DOMAIN/api/auth/callback/github
# Optional: leave both unset to disable GitHub login.
AUTH_GITHUB_ID="REPLACE_WITH_GITHUB_CLIENT_ID"
AUTH_GITHUB_SECRET="REPLACE_WITH_GITHUB_CLIENT_SECRET"


# Paymob
# Settings → API Keys (Secret + Public) | Webhooks → HMAC Secret | Developers → Integration ID
PAYMOB_API_URL="https://accept.paymob.com"
PAYMOB_SECRET_KEY="egy_sk_test_REPLACE_ME"
PAYMOB_PUBLIC_KEY="egy_pk_test_REPLACE_ME"
PAYMOB_HMAC_SECRET="REPLACE_WITH_HMAC_SECRET"
PAYMOB_API_KEY="REPLACE_WITH_LEGACY_API_KEY"
PAYMOB_INTEGRATION_IDS="REPLACE_WITH_INTEGRATION_ID"
PAYMOB_RETRY_MAX=3
PAYMOB_RETRY_INITIAL_MS=1000
PAYMOB_TIMEOUT_MS=15000

# Mux (Video Streaming)
# https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID="REPLACE_WITH_MUX_TOKEN_ID"
MUX_TOKEN_SECRET="REPLACE_WITH_MUX_TOKEN_SECRET"

# Bunny Stream (optional — signed HLS playback URLs)
# https://docs.bunny.net/docs/stream-security
# BUNNY_STREAM_CDN_HOSTNAME="vz-xxxxx.b-cdn.net"
# BUNNY_STREAM_TOKEN_AUTH_KEY="REPLACE_WITH_BUNNY_TOKEN_AUTH_KEY"

# Email (Resend)
# RESEND_API_KEY="re_REPLACE_ME"
# PAYMENT_EMAIL_FROM="noreply@yourdomain.com"
# CONTACT_NOTIFICATION_EMAIL="hodanabeil67@gmail.com"

# Cloudflare Turnstile (optional in local dev)
# Production keys are domain-restricted; in development the app automatically
# uses Cloudflare test keys on localhost unless TURNSTILE_USE_PRODUCTION_KEYS=true.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="REPLACE_WITH_TURNSTILE_SITE_KEY"
# TURNSTILE_SECRET_KEY="REPLACE_WITH_TURNSTILE_SECRET_KEY"
# TURNSTILE_USE_PRODUCTION_KEYS="false"

# --- Sentry ---
# Public (inlined into the browser bundle at BUILD time)
NEXT_PUBLIC_SENTRY_DSN=""
# development | staging | production  (set per environment; not derived from NODE_ENV)
SENTRY_ENVIRONMENT="development"
# Build-time only secrets/settings (CI / hosting build env; NEVER NEXT_PUBLIC_*)
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="ithracode"
SENTRY_PROJECT="ithracode-web"
# Local/staging only: enables /debug/sentry-test and /api/debug/sentry-test[/edge]. Ignored in production.
SENTRY_TEST_ENDPOINT_ENABLED="false"
# Optional: verbose SDK logging
SENTRY_DEBUG="false"
