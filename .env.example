# =============================================================================
# IthraCode — Local Development Environment
# =============================================================================
# Copy this file to `.env` and replace placeholders with real values.
# Never commit `.env` or live secrets.
#
# Required at startup (src/config/env.ts):
#   DATABASE_URL, REDIS_URL, AUTH_SECRET, AUTH_URL,
#   NEXT_PUBLIC_APP_URL
#
# Production / Vercel: see `.env.vercel.example` and `VERCEL_ENV_SETUP.md`
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional. Client fallback is localhost if unset — set this in production.
# NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# -----------------------------------------------------------------------------
# 2. Database (PostgreSQL) — required
# -----------------------------------------------------------------------------
# Local (docker compose):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ithracode"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ithracode"
# Neon:
#   DATABASE_URL  = pooled host  (...-pooler....neon.tech)  — app runtime
#   DIRECT_URL    = direct host  (...neon.tech)             — migrations only
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ithracode"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ithracode"

# -----------------------------------------------------------------------------
# 3. Redis — required (cache, locks, BullMQ)
# -----------------------------------------------------------------------------
# Local (docker compose maps host 6380 → container 6379)
# Production: use TLS, e.g. rediss://default:TOKEN@REGION.upstash.io:6379
REDIS_URL="redis://localhost:6380"

# -----------------------------------------------------------------------------
# 4. Authentication (Auth.js v5) — required
# -----------------------------------------------------------------------------
# Generate AUTH_SECRET: openssl rand -hex 32
AUTH_SECRET="REPLACE_WITH_64_HEX_CHARS"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# AUTH_URL is the site origin only (no /api/auth path).
# Do not set NEXTAUTH_URL or NEXTAUTH_SECRET — the app uses AUTH_* only.
# COOKIE_DOMAIN=".ithracode.com"

# -----------------------------------------------------------------------------
# 5. OAuth — optional (set both ID and secret, or neither)
# -----------------------------------------------------------------------------
# Google — https://console.cloud.google.com/apis/credentials
# Callback: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="REPLACE_WITH_GOOGLE_CLIENT_ID"
AUTH_GOOGLE_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"

# GitHub — https://github.com/settings/developers
# Callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="REPLACE_WITH_GITHUB_CLIENT_ID"
AUTH_GITHUB_SECRET="REPLACE_WITH_GITHUB_CLIENT_SECRET"

# -----------------------------------------------------------------------------
# 6. Payments — Paymob
# Optional locally (FakePaymentGateway in development).
# Required in production for live checkout.
# Dashboard: API Keys | Webhooks (HMAC) | Developers → Integration ID
# Webhook: https://YOUR_DOMAIN/api/payment/webhooks/paymob
# -----------------------------------------------------------------------------
PAYMOB_API_URL="https://accept.paymob.com"
PAYMOB_SECRET_KEY="egy_sk_test_REPLACE_ME"
PAYMOB_PUBLIC_KEY="egy_pk_test_REPLACE_ME"
PAYMOB_HMAC_SECRET="REPLACE_WITH_HMAC_SECRET"
PAYMOB_API_KEY="REPLACE_WITH_LEGACY_API_KEY"
PAYMOB_INTEGRATION_IDS="REPLACE_WITH_INTEGRATION_ID"
PAYMOB_RETRY_MAX=3
PAYMOB_RETRY_INITIAL_MS=1000
PAYMOB_TIMEOUT_MS=15000
# PAYMOB_CIRCUIT_BREAKER_THRESHOLD=5
# PAYMOB_CIRCUIT_BREAKER_RESET_MS=60000
# PAYMOB_WEBHOOK_REPLAY_WINDOW_SECONDS=300

# -----------------------------------------------------------------------------
# 7. Video — Bunny Stream (optional signed HLS)
# https://docs.bunny.net/docs/stream-security
# BUNNY_STREAM_CDN_HOSTNAME="vz-xxxxx.b-cdn.net"
# BUNNY_STREAM_TOKEN_AUTH_KEY="REPLACE_WITH_BUNNY_TOKEN_AUTH_KEY"

# -----------------------------------------------------------------------------
# 8. Email — Resend (optional; sending is skipped if unset)
# -----------------------------------------------------------------------------
# RESEND_API_KEY="re_REPLACE_ME"
# PAYMENT_EMAIL_FROM="noreply@yourdomain.com"
# CONTACT_NOTIFICATION_EMAIL="admin@yourdomain.com"

# -----------------------------------------------------------------------------
# 9. Cloudflare Turnstile — optional locally
# Production keys are domain-restricted. On localhost the app uses Cloudflare
# test keys unless TURNSTILE_USE_PRODUCTION_KEYS=true.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="REPLACE_WITH_TURNSTILE_SITE_KEY"
# TURNSTILE_SECRET_KEY="REPLACE_WITH_TURNSTILE_SECRET_KEY"
# TURNSTILE_USE_PRODUCTION_KEYS="false"

# -----------------------------------------------------------------------------
# 10. Observability — Sentry (optional)
# NEXT_PUBLIC_SENTRY_DSN is inlined into the browser bundle at build time.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_ORG="ithracode"
SENTRY_PROJECT="ithracode-web"
SENTRY_TEST_ENDPOINT_ENABLED="false"
SENTRY_DEBUG="false"
# SENTRY_AUTH_TOKEN=""   # build-time only — source map upload

# -----------------------------------------------------------------------------
# 11. Payment ops (optional — defaults apply if omitted)
# -----------------------------------------------------------------------------
# PAYMENT_RECONCILE_ADMIN_SECRET="REPLACE_WITH_RANDOM_BEARER_TOKEN"
# PAYMENT_ANALYTICS_ENABLED="false"

# -----------------------------------------------------------------------------
# 12. Local only — never set on Vercel
# -----------------------------------------------------------------------------
# Disables env validation. Local debugging only. Never enable in production.
# SKIP_ENV_VALIDATION="true"
