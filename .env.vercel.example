# =============================================================================
# IthraCode — Vercel Production Environment
# =============================================================================
# Paste into: Vercel → Project → Settings → Environment Variables
# Never commit live secrets. Mark sensitive values as Sensitive in Vercel.
#
# Replace YOUR_DOMAIN with the real origin, e.g. https://ithracode.com
# Full checklist: VERCEL_ENV_SETUP.md
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application — required (build + runtime)
# -----------------------------------------------------------------------------
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://YOUR_DOMAIN"
# Set if the API is not same-origin. Recommended in production so the client
# does not fall back to localhost.
# NEXT_PUBLIC_API_URL="https://YOUR_DOMAIN/api"

# -----------------------------------------------------------------------------
# 2. Database (Neon) — required
# -----------------------------------------------------------------------------
# DATABASE_URL = pooled host (...-pooler....neon.tech) — serverless runtime
# DIRECT_URL   = direct host — migrations CLI only; optional on Vercel
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# 3. Redis (Upstash) — required
# -----------------------------------------------------------------------------
REDIS_URL="rediss://default:PASSWORD@REGION.upstash.io:6379"

# -----------------------------------------------------------------------------
# 4. Authentication (Auth.js v5) — required
# -----------------------------------------------------------------------------
# Generate: openssl rand -hex 32
AUTH_SECRET="REPLACE_WITH_64_HEX_CHARS"
AUTH_URL="https://YOUR_DOMAIN"
AUTH_TRUST_HOST="true"
# AUTH_URL is the site origin only (no /api/auth).
# Do not set NEXTAUTH_URL or NEXTAUTH_SECRET.
# COOKIE_DOMAIN=".ithracode.com"

# -----------------------------------------------------------------------------
# 5. OAuth — optional (set both ID and secret, or neither)
# -----------------------------------------------------------------------------
# Google callback:  https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID="REPLACE_WITH_GOOGLE_CLIENT_ID"
AUTH_GOOGLE_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"
# GitHub callback:  https://YOUR_DOMAIN/api/auth/callback/github
AUTH_GITHUB_ID="REPLACE_WITH_GITHUB_CLIENT_ID"
AUTH_GITHUB_SECRET="REPLACE_WITH_GITHUB_CLIENT_SECRET"

# -----------------------------------------------------------------------------
# 6. Payments — Paymob — required for production checkout
# Webhook: https://YOUR_DOMAIN/api/payment/webhooks/paymob
# Use live keys in Production, test keys in Preview.
# -----------------------------------------------------------------------------
PAYMOB_API_URL="https://accept.paymob.com"
PAYMOB_SECRET_KEY="egy_sk_live_REPLACE_ME"
PAYMOB_PUBLIC_KEY="egy_pk_live_REPLACE_ME"
PAYMOB_HMAC_SECRET="REPLACE_WITH_HMAC_SECRET"
PAYMOB_API_KEY="REPLACE_WITH_LEGACY_API_KEY"
PAYMOB_INTEGRATION_IDS="REPLACE_WITH_INTEGRATION_ID"

# -----------------------------------------------------------------------------
# 7. Video — Bunny Stream
# -----------------------------------------------------------------------------
BUNNY_STREAM_CDN_HOSTNAME="vz-xxxxx.b-cdn.net"
BUNNY_STREAM_TOKEN_AUTH_KEY="REPLACE_WITH_BUNNY_TOKEN_AUTH_KEY"

# -----------------------------------------------------------------------------
# 8. Email — Resend (recommended)
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_REPLACE_ME"
PAYMENT_EMAIL_FROM="noreply@yourdomain.com"
CONTACT_NOTIFICATION_EMAIL="admin@yourdomain.com"

# -----------------------------------------------------------------------------
# 9. Cloudflare Turnstile — recommended for the contact form
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY="REPLACE_WITH_TURNSTILE_SITE_KEY"
TURNSTILE_SECRET_KEY="REPLACE_WITH_TURNSTILE_SECRET_KEY"
TURNSTILE_USE_PRODUCTION_KEYS="true"

# -----------------------------------------------------------------------------
# 10. Observability — Sentry (recommended; DSN must be present at build)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN="https://KEY@oORG.ingest.sentry.io/PROJECT"
SENTRY_ENVIRONMENT="production"
SENTRY_ORG="ithracode"
SENTRY_PROJECT="ithracode-web"
SENTRY_TEST_ENDPOINT_ENABLED="false"
SENTRY_DEBUG="false"
# SENTRY_AUTH_TOKEN="sntrys_REPLACE"   # build-time source maps only

# -----------------------------------------------------------------------------
# 11. Payment ops (optional)
# Admin API: Authorization: Bearer <PAYMENT_RECONCILE_ADMIN_SECRET>
# -----------------------------------------------------------------------------
# PAYMENT_RECONCILE_ADMIN_SECRET="REPLACE_WITH_RANDOM_BEARER_TOKEN"
# PAYMENT_ANALYTICS_ENABLED="false"

# -----------------------------------------------------------------------------
# Never set on Vercel
# -----------------------------------------------------------------------------
# SKIP_ENV_VALIDATION
# STRIPE_*  OPENAI_*  AI_*  PAYMENT_PROVIDER  WEBHOOK_SMOKE_BASE_URL
